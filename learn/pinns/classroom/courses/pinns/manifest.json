  "sources": [
    {
      "id": "raissi2017",
      "name": "Raissi, Perdikaris & Karniadakis, Physics Informed Deep Learning (2017), Parts I and II",
      "url": "https://maziarraissi.github.io/PINNs/",
      "text": "Open author exposition and code for differentiable solution networks, PDE residuals, initial/boundary observations, and forward/inverse modelling. Author manuscripts: https://arxiv.org/abs/1711.10561 and https://arxiv.org/abs/1711.10566 ."
    },
    {
      "id": "wang2023",
      "name": "Wang, Sankaran, Wang & Perdikaris, An Expert’s Guide to Training PINNs (2023)",
      "url": "https://arxiv.org/html/2308.08468v1",
      "text": "Open manuscript covering nondimensionalization, architecture, loss balancing, temporal causality, curriculum, sampling and boundary constraints. Practical methods are problem-dependent and are not universal convergence guarantees."
    },
    {
      "id": "failure2021",
      "name": "Krishnapriyan et al., Characterizing Possible Failure Modes in PINNs (2021)",
      "url": "https://arxiv.org/html/2109.01050v1",
      "text": "Open manuscript demonstrating optimisation failures for convection, reaction and reaction-diffusion problems and investigating curriculum and sequential-in-time training. Expressive networks need not be easy to optimize."
    },
    {
      "id": "torchdocs",
      "name": "PyTorch official autograd tutorial",
      "url": "https://docs.pytorch.org/tutorials/beginner/introyt/autogradyt_tutorial.html",
      "text": "Official graph-based automatic differentiation documentation. The independent lab uses torch.autograd.grad(create_graph=True) for coordinate derivatives that remain differentiable with respect to network weights."
    },
    {
      "id": "heatdocs",
      "name": "DeepXDE official heat-equation example",
      "url": "https://deepxde.readthedocs.io/en/latest/demos/pinn_forward/heat.html",
      "text": "Official heat example with sinusoidal initial data and zero Dirichlet boundaries. This course independently chooses a dimensionless unit domain, alpha=0.1 and exp(-alpha*pi^2*t)*sin(pi*x), rather than reproducing published accuracy claims."
    },
    {
      "id": "course-demo",
      "name": "Independent locally executed PINN experiment",
      "url": "/demos/pinns_train.py",
      "text": "Synthetic dimensionless heat problem: alpha=0.1, sine initial data, zero boundary values. Small smooth PyTorch networks trained on CPU with seed 7 in forward, inverse and omitted-initial-condition configurations. Held-out relative L2 and independent residual checks are logged. Inverse observations include Gaussian noise with standard deviation 0.005. These are teaching runs, not paper benchmarks."
    },
    {
      "id": "gradients2020",
      "name": "Wang, Teng & Perdikaris, Understanding and mitigating gradient pathologies in PINNs (2020)",
      "url": "https://arxiv.org/abs/2001.04536",
      "text": "Primary study of imbalanced back-propagated gradients in composite PINN objectives, with adaptive training strategies. Used for the diagnosis of conflicting loss components, not as a guarantee that a specific weighting rule always works."
    },
    {
      "id": "ntk2020",
      "name": "Wang, Yu & Perdikaris, When and why PINNs fail to train (2020)",
      "url": "https://arxiv.org/abs/2007.14527",
      "text": "Primary neural-tangent-kernel analysis of discrepant convergence rates and training difficulties, under its stated assumptions. Its limiting analysis is not an exact description of every finite nonlinear network."
    },
    {
      "id": "causality2022",
      "name": "Wang, Sankaran & Perdikaris, Respecting causality is all you need for training PINNs (2022)",
      "url": "https://arxiv.org/abs/2203.07404",
      "text": "Primary temporal-training study motivating the need to respect causal evolution in difficult time-dependent problems. Its title should not be interpreted as a universal guarantee across all PDEs."
    },
    {
      "id": "operator2020",
      "name": "Li et al., Fourier Neural Operator (2020); Lu et al., DeepONet (2019)",
      "url": "https://arxiv.org/abs/2010.08895",
      "text": "Primary operator-learning papers: https://arxiv.org/abs/2010.08895 and https://arxiv.org/abs/1910.03193 . Learning a mapping between functions across a problem family is distinct from fitting one coordinate network to one fixed PDE instance."
    }
  ],
